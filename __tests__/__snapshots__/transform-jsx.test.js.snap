exports[`transform-jsx 41. allows for deeply nested observables: 41. allows for deeply nested observables 1`] = `


const Component_DeeplyNested = () => {
  const user = observe({
    address: {
      line1: "123 Main St",
      line2: "Apt 4B",
      city: "New York",
      state: "NY",
      zip: "10001",
      country: {
        name: "USA",
        code: "1"
      }
    }
  });

  const onClick = () => {
    user = {...user, address: {country: {code: "2"}}}
  }


  return <div handle:click={onClick}>{user.address.country.code}</div>;
};
      

      ↓ ↓ ↓ ↓ ↓ ↓

const Component_DeeplyNested = () => {
  const user = observe({
    address: {
      line1: "123 Main St",
      line2: "Apt 4B",
      city: "New York",
      state: "NY",
      zip: "10001",
      country: {
        name: "USA",
        code: "1"
      }
    }
  });
  const onClick = () => {
    user.set({
      ...user.value,
      address: {
        country: {
          code: "2"
        }
      }
    });
  };
  return Cosmq.registerElement("div", {
    "handle:click": onClick
  }, [Cosmq.compute(() => user.value.address.country.code, [user])]);
};

`;
