const Component_SomeComponent = () => {
  const ctx = loadContext()
  const reassigned = ctx.c;
  const test_compute = compute(ctx.a + ctx.b)

  const handleMouseDown = () => {
    ctx.c = ctx.a + ctx.b
  }
  
  return (
    <div 
      handle:click={() => {
        ctx.b = ctx.a / ctx.b;
      }}
      handle:mousedown={handleMouseDown}
      style={{
        opacity: ctx.b + ctx.a,
        position: ctx.c
      }}
    >Hello World
    </div>
  )
};


      ↓ ↓ ↓ ↓ ↓ ↓

const Component_SomeComponent = () => {
  const ctx = loadContext();
  const __Cosmq_Context__ctx_b = ctx.b;
  const __Cosmq_Context__ctx_a = ctx.a;
  const __Cosmq_Context__ctx_c = ctx.c;
  const reassigned = __Cosmq_Context__ctx_c;
  const test_compute = compute(() => __Cosmq_Context__ctx_a.value + __Cosmq_Context__ctx_b.value, [__Cosmq_Context__ctx_a, __Cosmq_Context__ctx_b]);
  const handleMouseDown = () => {
    __Cosmq_Context__ctx_c.set(__Cosmq_Context__ctx_a.value + __Cosmq_Context__ctx_b.value);
  };
  return Cosmq.registerElement("div", {
    "handle:click": () => {
      __Cosmq_Context__ctx_b.set(__Cosmq_Context__ctx_a.value / __Cosmq_Context__ctx_b.value);
    },
    "handle:mousedown": handleMouseDown,
    "style": /*COSMQ - Injected Computed wrapper*/Cosmq.compute(() => {
      return {
        opacity: __Cosmq_Context__ctx_b.value + __Cosmq_Context__ctx_a.value,
        position: __Cosmq_Context__ctx_c.value
      };
    }, [__Cosmq_Context__ctx_b, __Cosmq_Context__ctx_a, __Cosmq_Context__ctx_c])
  }, ["Hello World\\n    "]);
};

`;

exports[`transform-jsx 32. Infers ReactiveList: 32. Infers ReactiveList 1`] = `



const Component_Project = ({items}) => {
  const items2 = observe([{id: 1, name: "test"},{id: 2, name: "test2"}])
  const activeItem = observe(null)

  return (
    <div>
      {items.map(item => (
        <div key={item.id}>
          {item.name}
        </div>
      ))}

      {items2.map(item => (
        <div key={item.id} style={{
          opacity: activeItem?.id === item.id ? 1 : 0.3
        }}>
          {item.name}
        </div>
      ))}
    </div>
  );
}
      

      ↓ ↓ ↓ ↓ ↓ ↓

const Component_Project = ({
  items
}) => {
  const items2 = observe([{
    id: 1,
    name: "test"
  }, {
    id: 2,
    name: "test2"
  }]);
  const activeItem = observe(null);
  return Cosmq.registerElement("div", {}, [/*COSMQ - Injected ReactiveList*/Cosmq.reactiveList(items, {
    getKey: item => item.id
  }, item => Cosmq.registerElement("div", {
    "key": item.id
  }, [item.name])), /*COSMQ - Injected ReactiveList*/Cosmq.reactiveList(items2, {
    getKey: item => item.id
  }, item => Cosmq.registerElement("div", {
    "key": item.id,
    "style": /*COSMQ - Injected Computed wrapper*/Cosmq.compute(() => {
      return {
        opacity: activeItem.value?.id === item.id ? 1 : 0.3
      };
    }, [activeItem])
  }, [item.name]))]);
};

`;

