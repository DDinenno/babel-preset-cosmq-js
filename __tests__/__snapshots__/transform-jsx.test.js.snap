exports[`transform-jsx 30. define Context: 30. define Context 1`] = `


const Store = createContext({
    a: 1,
    b: 2,
    c: 0,
    d: {a: 1},
    e: [1, 2, 3],
})

const actionA = () => {
    const c = store.a + store.b;
    return c 
}

function actionB() {
    const c = store.a + store.b;
    return c 
}


      ↓ ↓ ↓ ↓ ↓ ↓

const Store = createContext({
  a: 1,
  b: 2,
  c: 0,
  d: {
    a: 1
  },
  e: [1, 2, 3]
});
const actionA = () => {
  const c = store.a + store.b;
  return c;
};
function actionB() {
  const c = store.a + store.b;
  return c;
}

`;

